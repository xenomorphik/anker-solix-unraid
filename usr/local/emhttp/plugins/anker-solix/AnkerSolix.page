Menu="Utilities"
Title="Anker Solix Power Monitor"
Icon="anker-solix.png"
---
<?php
$plugin = "anker-solix";
$cfg_file = "/boot/config/plugins/".$plugin."/anker-solix.cfg";
$cfg = parse_ini_file($cfg_file) ?: [];

$status_file = "/tmp/anker-solix/status.json";
$status = json_decode(@file_get_contents($status_file), true) ?: [
  "device_name" => "Anker SOLIX S2000",
  "status" => "ONLINE",
  "battery_soc" => 100,
  "battery_soh" => 100,
  "input_power_w" => 0,
  "output_power_w" => 0,
  "time_left_min" => 0,
  "temperature_c" => 0,
  "grid_connected" => true
];

$is_online = ($status['status'] === 'ONLINE' || ($status['grid_connected'] ?? true));
?>

<div class="row">
  <div class="col-md-6">
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title">Live System Telemetry</h3>
      </div>
      <div class="panel-body">
        <table class="table">
          <tr>
            <td><strong>Device Model:</strong></td>
            <td><strong><?=htmlspecialchars($status['device_name'] ?? 'SOLIX S2000')?></strong> (<?=htmlspecialchars($status['device_pn'] ?? 'AS220')?>)</td>
          </tr>
          <tr>
            <td><strong>Line / Grid Status:</strong></td>
            <td>
              <?php if ($is_online): ?>
                <span class="label label-success">ONLINE (Grid Connected)</span>
              <?php else: ?>
                <span class="label label-danger">ON BATTERY (Power Outage)</span>
              <?php endif; ?>
            </td>
          </tr>
          <tr>
            <td><strong>Battery Charge (SOC):</strong></td>
            <td><strong style="font-size: 1.2em; color: <?=($status['battery_soc'] > 20 ? '#27ae60' : '#e74c3c')?>;"><?=intval($status['battery_soc'])?>%</strong> (Health: <?=intval($status['battery_soh'] ?? 100)?>%)</td>
          </tr>
          <tr>
            <td><strong>Grid Input Power:</strong></td>
            <td><?=floatval($status['input_power_w'])?> W</td>
          </tr>
          <tr>
            <td><strong>AC Output / Server Load:</strong></td>
            <td><strong><?=floatval($status['output_power_w'])?> W</strong></td>
          </tr>
          <tr>
            <td><strong>Estimated Runtime Left:</strong></td>
            <td><?=round(floatval($status['time_left_min']))?> Minutes (<?=round(floatval($status['time_left_min'])/60, 1)?> hrs)</td>
          </tr>
          <tr>
            <td><strong>Internal Temperature:</strong></td>
            <td><?=floatval($status['temperature_c'])?> &deg;C</td>
          </tr>
          <tr>
            <td><strong>Last Telemetry Sync:</strong></td>
            <td><?=htmlspecialchars($status['timestamp'] ?? 'N/A')?></td>
          </tr>
        </table>
      </div>
    </div>
  </div>

  <div class="col-md-6">
    <form markdown="1" method="POST" action="/update.php" target="progressFrame">
      <input type="hidden" name="#file" value="<?=$cfg_file?>">
      
      <div class="panel panel-default">
        <div class="panel-heading">
          <h3 class="panel-title">Anker Solix Credentials & Thresholds</h3>
        </div>
        <div class="panel-body">
          <p>
            <label>Anker Account Email / Username:</label>
            <input type="email" name="ANKERUSER" value="<?=htmlspecialchars($cfg['ANKERUSER'] ?? '')?>" placeholder="user@example.com" required>
          </p>
          <p>
            <label>Anker Account Password:</label>
            <input type="password" name="ANKERPASSWORD" value="<?=htmlspecialchars($cfg['ANKERPASSWORD'] ?? '')?>" required>
          </p>
          <p>
            <label>Anker Country Code:</label>
            <input type="text" name="ANKERCOUNTRY" value="<?=htmlspecialchars($cfg['ANKERCOUNTRY'] ?? 'us')?>" size="4" required>
          </p>
          <p>
            <label>Polling Interval (seconds):</label>
            <input type="number" name="POLL_INTERVAL" value="<?=intval($cfg['POLL_INTERVAL'] ?? 15)?>" min="5" max="300" required>
          </p>
          <p>
            <label>Shutdown Delay on Battery (minutes):</label>
            <input type="number" name="TIME_LIMIT_MIN" value="<?=intval($cfg['TIME_LIMIT_MIN'] ?? 10)?>" min="1" max="120" required>
          </p>
          <p>
            <label>Minimum Battery % Threshold:</label>
            <input type="number" name="BATTERY_LIMIT_PCT" value="<?=intval($cfg['BATTERY_LIMIT_PCT'] ?? 20)?>" min="5" max="90" required>
          </p>
          <p>
            <input type="submit" value="Apply Settings" class="btn btn-primary">
            <button type="button" id="test-auth-btn" class="btn btn-default" onclick="testAnkerAuth()">Test Credentials</button>
          </p>
          <div id="auth-test-result" style="display:none; margin-top:10px;"></div>
        </div>
      </div>
    </form>
  </div>
</div>

<script>
function testAnkerAuth() {
    var user = $('input[name="ANKERUSER"]').val();
    var pass = $('input[name="ANKERPASSWORD"]').val();
    var country = $('input[name="ANKERCOUNTRY"]').val() || 'us';
    
    var $res = $('#auth-test-result');
    var $btn = $('#test-auth-btn');

    if (!user || !pass) {
        $res.removeClass().addClass('alert alert-warning').html('Please fill in Email and Password before testing.').show();
        return;
    }

    $btn.prop('disabled', true).text('Testing Login...');
    $res.removeClass().addClass('alert alert-info').html('Connecting to Anker Solix API...').show();

    $.post('/plugins/anker-solix/AnkerSolix.php?action=test_auth', {
        user: user,
        password: pass,
        country: country
    }, function(data) {
        $btn.prop('disabled', false).text('Test Credentials');
        if (data && data.success) {
            $res.removeClass().addClass('alert alert-success').html('<strong>✓ Success:</strong> ' + data.message);
        } else {
            var msg = (data && data.message) ? data.message : 'Authentication failed.';
            $res.removeClass().addClass('alert alert-danger').html('<strong>✗ Error:</strong> ' + msg);
        }
    }, 'json').fail(function() {
        $btn.prop('disabled', false).text('Test Credentials');
        $res.removeClass().addClass('alert alert-danger').html('<strong>✗ Error:</strong> Failed to communicate with plugin backend.');
    });
}
</script>
