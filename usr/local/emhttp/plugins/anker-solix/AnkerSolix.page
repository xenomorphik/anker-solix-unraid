            <td><strong>Battery Charge (SOC):</strong></td>
            <td>
              <strong style="font-size: 1.25em; color: <?=($status['battery_soc'] > 20 ? '#27ae60' : '#e74c3c')?>;">
                <?=intval($status['battery_soc'])?>%
              </strong>
              (Health: <?=intval($status['battery_soh'] ?? 100)?>%)
