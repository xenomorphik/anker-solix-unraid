          <p>
            <label>Anker Account Email / Username:</label>
            <input type="email" name="ANKERUSER" value="<?=htmlspecialchars($cfg['ANKERUSER'] ?? '')?>" placeholder="user@example.com" class="form-control" style="width:100%; max-width:320px;" required>
          </p>
          <p>
            <label>Anker Account Password:</label>
            <input type="password" name="ANKERPASSWORD" value="<?=htmlspecialchars($cfg['ANKERPASSWORD'] ?? '')?>" class="form-control" style="width:100%; max-width:320px;" required>
          </p>
          <p>
            <label>Anker Country Code:</label>
            <input type="text" name="ANKERCOUNTRY" value="<?=htmlspecialchars($cfg['ANKERCOUNTRY'] ?? 'us')?>" size="4" class="form-control" style="width:60px;" required>
          </p>
          <p>
            <label>Polling Interval (seconds):</label>
            <input type="number" name="POLL_INTERVAL" value="<?=intval($cfg['POLL_INTERVAL'] ?? 15)?>" min="5" max="300" class="form-control" style="width:80px;" required>
          </p>
          <p>
            <label>Shutdown Delay on Outage (minutes):</label>
            <input type="number" name="TIME_LIMIT_MIN" value="<?=intval($cfg['TIME_LIMIT_MIN'] ?? 10)?>" min="1" max="120" class="form-control" style="width:80px;" required>
          </p>
          <p>
            <label>Shutdown Minimum Battery %:</label>
            <input type="number" name="BATTERY_LIMIT_PCT" value="<?=intval($cfg['BATTERY_LIMIT_PCT'] ?? 20)?>" min="5" max="90" class="form-control" style="width:80px;" required>
          </p>
          <hr>
          <p>
            <input type="submit" value="Apply Settings" class="btn btn-primary">
            <button type="button" id="test-auth-btn" class="btn btn-default" onclick="testAnkerAuth()">Test Credentials</button>
          </p>
          <div id="auth-test-result" style="display:none; margin-top:12px;"></div>
        </div>
      </div>
    </form>
  </div>
