<?php
$plugin = "anker-solix";
$cfg_file = "/boot/config/plugins/".$plugin."/anker-solix.cfg";
$cfg = parse_ini_file($cfg_file) ?: [];

$status_file = "/tmp/anker-solix/status.json";
$status = json_decode(@file_get_contents($status_file), true) ?: [
  "device_name" => "Anker SOLIX S2000",
  "status" => "ONLINE",
  "battery_soc" => 100,
  "battery_soh" => 100,
  "input_power_w" => 0,
  "output_power_w" => 0,
  "time_left_min" => 0,
  "temperature_c" => 0,
  "grid_connected" => true
];

$is_online = ($status['status'] === 'ONLINE' || ($status['grid_connected'] ?? true));
?>

