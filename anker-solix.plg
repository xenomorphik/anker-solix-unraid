<?xml version='1.0' encoding='utf-8'?>
<!DOCTYPE PLUGIN [
  <!ENTITY name      "anker-solix">
  <!ENTITY author    "Conductor Architect">
  <!ENTITY version   "2026.09.18.6">
  <!ENTITY launch    "Settings/AnkerSolix">
  <!ENTITY pluginurl "https://raw.githubusercontent.com/xenomorphik/anker-solix-unraid/main/anker-solix.plg">
]>

<plugin name="&name;" author="&author;" version="&version;" launch="&launch;" pluginurl="&pluginurl;" min="6.9.0">

<CHANGELOG>
### 2026.09.18.6
- Pass active Anker credentials dynamically into daemon polling cycle.
- Fix Python SSL library compatibility (openssl-solibs-1.1.1m) on Unraid.
- Ensure monitoring daemon runs cleanly in detached background context.
### 2026.09.18.5
- Fix JSON line extraction in PHP to ignore stdout log header output.
### 2026.09.18.4
- Add auto-installation of Python 3 package for Unraid systems missing python3.
### 2026.09.18.3
- Fix PHP double-quote variable string interpolation in shell_exec PATH definition.
### 2026.09.18.2
- Fix python path discovery in PHP web server shell execution.
### 2026.09.18.1
- Add Test Credentials feature to WebGUI settings page and API client.
### 2026.09.18
- Fix Slackware package compression to native XZ format and update installation hooks.
### 2026.08.28
- Initial MVP release of Unraid Anker Solix Power Monitor &amp; Graceful Shutdown Plugin.
</CHANGELOG>

<!-- Pre-installation check & directory initialization -->
<FILE Run="/bin/bash">
<INLINE>
mkdir -p /boot/config/plugins/&name;
mkdir -p /tmp/&name;

# Ensure OpenSSL 1.1 compatibility libraries are present for Python 3.9
if ! python3 -c "import ssl" &amp;&gt;/dev/null; then
    echo "Configuring SSL libraries for Python 3 on Unraid..."
    OPENSSL_PKG="openssl-solibs-1.1.1m-x86_64-1.txz"
    OPENSSL_URL="https://slackware.uk/slackware/slackware64-15.0/slackware64/a/${OPENSSL_PKG}"
    if [ ! -f "/boot/config/plugins/&name;/${OPENSSL_PKG}" ]; then
        curl -sSL "$OPENSSL_URL" -o "/boot/config/plugins/&name;/${OPENSSL_PKG}"
    fi
    installpkg "/boot/config/plugins/&name;/${OPENSSL_PKG}"
fi

# Ensure Python 3 is installed on Unraid
if ! command -v python3 &amp;&gt;/dev/null; then
    echo "Python 3 is required by Anker Solix plugin. Downloading Python 3 package for Unraid..."
    PYTHON_PKG="python3-3.9.10-x86_64-1.txz"
    PYTHON_URL="https://slackware.uk/slackware/slackware64-15.0/slackware64/d/${PYTHON_PKG}"
    if [ ! -f "/boot/config/plugins/&name;/${PYTHON_PKG}" ]; then
        curl -sSL "$PYTHON_URL" -o "/boot/config/plugins/&name;/${PYTHON_PKG}"
    fi
    installpkg "/boot/config/plugins/&name;/${PYTHON_PKG}"
fi
</INLINE>
</FILE>

<!-- Main plugin package installation -->
<FILE Name="/boot/config/plugins/&name;/&name;-&version;.txz" Run="installpkg">
<URL>https://raw.githubusercontent.com/xenomorphik/anker-solix-unraid/main/dist/&name;-&version;.txz</URL>
</FILE>

<!-- Post-installation script to start monitoring daemon -->
<FILE Run="/bin/bash">
<INLINE>
echo "Initializing Anker Solix Plugin..."
pkill -f "solix_daemon.py" || true
if [ -f /usr/local/emhttp/plugins/&name;/solix_daemon.py ]; then
    if [ ! -d /usr/local/emhttp/plugins/&name;/venv ]; then
        python3 -m venv /usr/local/emhttp/plugins/&name;/venv
    fi
    (/usr/local/emhttp/plugins/&name;/venv/bin/python3 /usr/local/emhttp/plugins/&name;/solix_daemon.py &lt;/dev/null &gt;/dev/null 2&gt;&amp;1 &amp;)
fi
</INLINE>
</FILE>

<!-- Plugin Removal script -->
<FILE Run="/bin/bash" Method="remove">
<INLINE>
echo "Removing Anker Solix Plugin..."
pkill -f "solix_daemon.py" || true
rm -rf /usr/local/emhttp/plugins/&name;
rm -rf /tmp/&name;
rm -f /boot/config/plugins/&name;/&name;-&version;.txz
</INLINE>
</FILE>

</plugin>
